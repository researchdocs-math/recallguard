message: "Please cite this software when using the RecallGuard experiments."
type: software
title: "RecallGuard: Experiments for Certifying Recall When Reviewers Err"
version: 1.0.0
date-released: 2026-10-07
license: MIT
authors:
  - family-names: Yavas
    given-names: Cemil Emre
    orcid: "https://orcid.org/0009-0006-9552-1731"
